---
import { base, url } from "../lib/url";

const links = [
  { href: "data", label: "Data" },
  { href: "taco", label: "TACO" },
  { href: "paper", label: "Papers" },
  { href: "code", label: "Code" },
  { href: "project", label: "Project" },
];
const rel = Astro.url.pathname.replace(base, "");
---

<nav class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href={base}>
      <span class="nav__dot"></span>
      MethaneSET
    </a>
    <div class="nav__links" id="nav-links">
      {
        links.map((l) => {
          const active = rel.startsWith(l.href);
          return (
            <a href={url(`${l.href}/`)} aria-current={active ? "page" : undefined}>
              {l.label}
            </a>
          );
        })
      }
      <div class="nav__icons">
        <a
          class="nav__icon"
          href="https://github.com/IPL-UV/taco-methaneset"
          target="_blank"
          rel="noopener"
          title="GitHub"
          aria-label="GitHub"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path
              d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.4-1.27.73-1.56-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"
            /></svg>
        </a>
        <a
          class="nav__icon"
          href="https://huggingface.co/datasets/tacofoundation/methaneset"
          target="_blank"
          rel="noopener"
          title="Hugging Face"
          aria-label="Hugging Face"
        >
          <img class="nav__hf" src={`${base}logos/hf.svg`} alt="" />
        </a>
      </div>
    </div>
    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" type="button">
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
        ><circle cx="12" cy="12" r="4.2" /><path
          d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7"
        /></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
        ><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" /></svg>
    </button>
    <button
      class="nav__burger"
      id="nav-burger"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <svg class="burger-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
        ><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      <svg class="burger-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
        ><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>
</nav>

<script>
  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const current = document.documentElement.getAttribute("data-theme");
    const next = current === "light" ? "dark" : "light";
    document.documentElement.setAttribute("data-theme", next);
    try {
      localStorage.setItem("theme", next);
    } catch (e) {
      /* ignore */
    }
  });

  /* Mobile menu. The panel is CSS-hidden above 900px, so the attribute is
     harmless on desktop; we still close it on resize to keep state honest. */
  const burger = document.getElementById("nav-burger");
  const root = document.documentElement;

  const setOpen = (open: boolean) => {
    root.toggleAttribute("data-nav-open", open);
    burger?.setAttribute("aria-expanded", open ? "true" : "false");
  };

  burger?.addEventListener("click", () => {
    setOpen(!root.hasAttribute("data-nav-open"));
  });

  document.getElementById("nav-links")?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !root.hasAttribute("data-nav-open")) return;
    setOpen(false);
    burger?.focus();
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth > 900) setOpen(false);
  });
</script>

<style>
  [data-theme="light"] .icon-sun,
  :root:not([data-theme="light"]) .icon-moon {
    display: none;
  }

  /* toggling display restarts the animation, so the icon pops on each switch */
  .icon-sun,
  .icon-moon {
    animation: icon-swap 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes icon-swap {
    from {
      opacity: 0;
      transform: rotate(-70deg) scale(0.6);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .icon-sun,
    .icon-moon {
      animation: none;
    }
  }
</style>
