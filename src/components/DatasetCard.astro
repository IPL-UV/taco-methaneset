---
import { fmtSize, hfUrl, hfReadme, loadCode, type Dataset } from "../data/datasets";

interface Props {
  dataset: Dataset;
}
const { dataset } = Astro.props;

const icons: Record<string, string> = {
  hyper: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z"/><path d="M3 7l9 5 9-5M12 12v10"/></svg>`,
  s2: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="9" width="8" height="6" rx="1"/><rect x="13" y="9" width="8" height="6" rx="1"/><path d="M9 5l2 4M15 5l-2 4"/></svg>`,
  l89: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="4" y="10" width="16" height="5" rx="1"/><path d="M8 10V6m8 4V6"/><circle cx="12" cy="17.5" r="1"/></svg>`,
  bank: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3 3 7l9 4 9-4-9-4Z"/><path d="M3 12l9 4 9-4M3 16.5l9 4 9-4"/></svg>`,
};

const code = loadCode(dataset.name);
---

<article class="dcard">
  <div class="dcard__head">
    <span class="dcard__icon" set:html={icons[dataset.icon]} />
    <div>
      <h3>{dataset.name}</h3>
      <div class="dcard__meta">
        <span class="dcard__chip">{dataset.family}</span>
        <span class="dcard__chip">{dataset.subset}</span>
      </div>
    </div>
  </div>

  <p class="dcard__abstract">{dataset.abstract}</p>

  <div class="dcard__stats">
    <div><b>{dataset.samples.toLocaleString("en-US")}</b><span>samples</span></div>
    <div><b>{fmtSize(dataset.sizeGB)}</b><span>on disk</span></div>
  </div>

  <div class="dcard__code">
    <code>{code}</code>
    <button class="dcard__copy" data-copy={code} aria-label="Copy load path">copy</button>
  </div>

  <div class="dcard__links">
    <a class="dcard__link" href={hfUrl(dataset.name)} target="_blank" rel="noopener"
      >Hugging Face <span aria-hidden="true">→</span></a
    >
    <a class="dcard__link dcard__link--readme" href={hfReadme(dataset.name)} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"></path>
        <path d="M14 3v5h5M9 13h6M9 17h6"></path>
      </svg>
      README
    </a>
  </div>
</article>

<style>
  .dcard {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
    box-shadow: var(--card-shadow);
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease),
      transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .dcard::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--gradient);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .dcard:hover {
    border-color: var(--accent-line);
    background: var(--card-hover);
    transform: translateY(-3px);
    box-shadow: var(--card-shadow-hover);
  }
  .dcard:hover::before {
    transform: scaleX(1);
  }
  .dcard__head {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .dcard__icon {
    width: 56px;
    height: 56px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--accent-soft);
    border: 1px solid transparent;
    color: var(--teal);
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .dcard:hover .dcard__icon {
    border-color: var(--accent-line);
    transform: scale(1.06) rotate(-3deg);
  }
  .dcard__icon :global(svg) {
    width: 30px;
    height: 30px;
  }
  .dcard__head h3 {
    font-size: 1.02rem;
    margin: 0 0 7px;
    word-break: break-word;
  }
  .dcard__meta {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .dcard__chip {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 3px 9px;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .dcard:hover .dcard__chip {
    border-color: var(--line-strong);
    color: var(--text);
  }
  .dcard__abstract {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 16px 0;
    flex: 1;
  }
  .dcard__stats {
    display: flex;
    gap: 28px;
    margin-bottom: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .dcard__stats b {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    color: var(--text);
    display: block;
  }
  .dcard__stats span {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--slate);
    font-family: var(--font-mono);
  }
  .dcard__code {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--code-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 9px 10px;
    overflow: hidden;
    transition: border-color var(--dur) var(--ease);
  }
  .dcard:hover .dcard__code {
    border-color: var(--line-strong);
  }
  .dcard__code code {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--teal-light);
    white-space: normal;
    word-break: break-all;
    line-height: 1.55;
    flex: 1;
  }
  [data-theme="light"] .dcard__code code {
    color: #5eead4;
  }
  .dcard__copy {
    flex: none;
    align-self: stretch;
    background: transparent;
    border: 1px solid var(--line-strong);
    color: var(--muted);
    border-radius: 7px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    padding: 4px 9px;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  [data-theme="light"] .dcard__copy {
    border-color: rgba(148, 163, 184, 0.35);
    color: #94a3b8;
  }
  .dcard__copy:hover {
    color: var(--teal-light);
    border-color: var(--teal);
    background: var(--accent-soft);
  }
  [data-theme="light"] .dcard__copy:hover {
    color: #5eead4;
    border-color: #5eead4;
    background: rgba(94, 234, 212, 0.12);
  }
  .dcard__copy:active {
    transform: scale(0.94);
  }
  .dcard__links {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 16px;
  }
  .dcard__link {
    font-size: 0.88rem;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .dcard__link span[aria-hidden] {
    display: inline-block;
    transition: transform var(--dur) var(--ease);
  }
  .dcard__link:hover span[aria-hidden] {
    transform: translateX(4px);
  }
  .dcard__link svg {
    width: 18px;
    height: 18px;
    transition: transform var(--dur) var(--ease);
  }
  .dcard__link--readme {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .dcard__link--readme:hover {
    color: var(--teal-light);
  }
  .dcard__link--readme:hover svg {
    transform: translateY(-1px);
  }
</style>
