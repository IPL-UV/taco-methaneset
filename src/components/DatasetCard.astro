---
import { fmtSize, hfUrl, hfReadme, loadCode, type Dataset } from "../data/datasets";

interface Props {
  dataset: Dataset;
}
const { dataset } = Astro.props;

const icons: Record<string, string> = {
  hyper: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z"/><path d="M3 7l9 5 9-5M12 12v10"/></svg>`,
  s2: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="9" width="8" height="6" rx="1"/><rect x="13" y="9" width="8" height="6" rx="1"/><path d="M9 5l2 4M15 5l-2 4"/></svg>`,
  l89: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="4" y="10" width="16" height="5" rx="1"/><path d="M8 10V6m8 4V6"/><circle cx="12" cy="17.5" r="1"/></svg>`,
  bank: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 3 3 7l9 4 9-4-9-4Z"/><path d="M3 12l9 4 9-4M3 16.5l9 4 9-4"/></svg>`,
};

const code = loadCode(dataset.name);
---

<article class="dcard">
  <div class="dcard__head">
    <span class="dcard__icon" set:html={icons[dataset.icon]} />
    <div class="dcard__id">
      <p class="dcard__kind">{dataset.family} / {dataset.subset}</p>
      <h3>{dataset.name}</h3>
    </div>
  </div>

  <p class="dcard__abstract">{dataset.abstract}</p>

  <div class="dcard__stats">
    <div><b>{dataset.samples.toLocaleString("en-US")}</b><span>samples</span></div>
    <div><b>{fmtSize(dataset.sizeGB)}</b><span>on disk</span></div>
  </div>

  <div class="dcard__code">
    <code>{code}</code>
    <button class="dcard__copy" data-copy={code} type="button" title="Copy load path" aria-live="polite"
      >copy</button
    >
  </div>

  <div class="dcard__links">
    <a class="dcard__link" href={hfUrl(dataset.name)} target="_blank" rel="noopener"
      >Hugging Face <span aria-hidden="true">→</span></a
    >
    <a class="dcard__link dcard__link--readme" href={hfReadme(dataset.name)} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"></path>
        <path d="M14 3v5h5M9 13h6M9 17h6"></path>
      </svg>
      README
    </a>
  </div>
</article>

<style>
  .dcard {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .dcard:hover {
    border-color: var(--line-strong);
    background: var(--surface-hover);
  }
  .dcard__head {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  /* The mark identifies the sensor family; it is not a button, so it gets no
     tile, no tint and no hover trick. */
  .dcard__icon {
    flex: none;
    margin-top: 3px;
    color: var(--slate);
  }
  .dcard__icon :global(svg) {
    width: 26px;
    height: 26px;
    display: block;
  }
  .dcard__kind {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--slate);
    margin: 0 0 6px;
  }
  /* The dataset name is an identifier you type, so it is set as one. */
  .dcard__head h3 {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text);
    margin: 0;
    word-break: break-word;
  }
  .dcard__abstract {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.62;
    margin: 18px 0;
    flex: 1;
  }
  .dcard__stats {
    display: flex;
    gap: 32px;
    margin-bottom: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .dcard__stats b {
    font-size: 1.02rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    display: block;
  }
  .dcard__stats span {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--slate);
  }
  .dcard__code {
    display: flex;
    align-items: stretch;
    gap: 10px;
    background: var(--code-bg);
    border: 1px solid var(--code-line);
    border-radius: var(--radius-sm);
    padding: 9px 10px;
  }
  .dcard__code code {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--code-text);
    white-space: normal;
    word-break: break-all;
    line-height: 1.6;
    flex: 1;
    align-self: center;
  }
  .dcard__copy {
    flex: none;
    background: transparent;
    border: 1px solid rgba(148, 163, 184, 0.3);
    color: #94a3b8;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .dcard__copy:hover {
    color: #5eead4;
    border-color: rgba(94, 234, 212, 0.6);
  }
  .dcard__links {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 18px;
  }
  .dcard__link {
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .dcard__link span[aria-hidden] {
    display: inline-block;
    transition: transform var(--dur) var(--ease);
  }
  .dcard__link:hover span[aria-hidden] {
    transform: translateX(3px);
  }
  .dcard__link svg {
    width: 16px;
    height: 16px;
  }
  .dcard__link--readme {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--slate);
  }
  .dcard__link--readme:hover {
    color: var(--text);
  }
</style>
