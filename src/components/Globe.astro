---
interface Props {
  scrollZoom?: boolean;
  controls?: boolean;
  rotate?: boolean;
  focusRight?: boolean;
}
const { scrollZoom = false, controls = false, rotate = false, focusRight = false } = Astro.props;

const sensors = [
  { id: "EMIT", color: "#f97316", label: "EMIT (hyperspectral)" },
  { id: "Sentinel-2", color: "#2dd4bf", label: "Sentinel-2 (multispectral)" },
  { id: "Landsat 8/9", color: "#fde047", label: "Landsat 8/9 (multispectral)" },
];

const years = ["2018", "2019", "2020", "2021", "2022", "2023", "2024", "2025"];
---

<div class="globe-wrap">
  <div
    id="globe"
    class="globe"
    data-scroll-zoom={scrollZoom ? "true" : "false"}
    data-rotate={rotate ? "true" : "false"}
    data-controls={controls ? "true" : "false"}
    data-focus-right={focusRight ? "true" : "false"}></div>

  {controls && (
    <div class="globe-ui">
      <div class="globe-panel">
        <p class="globe-panel__title">
          Filters<span id="globe-count" class="globe-count"></span>
        </p>

        <div class="field">
          <span class="field__label">Sensors</span>
          <div class="field__checks">
            {
              sensors.map((s) => (
                <label class="globe-check">
                  <input type="checkbox" value={s.id} checked data-sensor />
                  <span class="globe-dot" style={`background:${s.color}`} />
                  {s.label}
                </label>
              ))
            }
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="country-select">Country</label>
          <select id="country-select" class="globe-select">
            <option value="">All countries</option>
          </select>
        </div>

        <div class="field field--pair">
          <div>
            <label class="field__label" for="year-from">From</label>
            <select id="year-from" class="globe-select">
              {years.map((y) => <option value={y}>{y}</option>)}
            </select>
          </div>
          <div>
            <label class="field__label" for="year-to">To</label>
            <select id="year-to" class="globe-select">
              {years.map((y) => <option value={y} selected={y === "2025"}>{y}</option>)}
            </select>
          </div>
        </div>

        <div class="field">
          <label class="field__label" for="flux-min">Min flux</label>
          <select id="flux-min" class="globe-select">
            <option value="0">Any</option>
            <option value="1000">≥ 1,000 kg/h</option>
            <option value="5000">≥ 5,000 kg/h</option>
            <option value="10000">≥ 10,000 kg/h</option>
          </select>
        </div>

        <div class="field">
          <label class="field__label" for="basemap-select">Basemap</label>
          <select id="basemap-select" class="globe-select">
            <option value="auto">Match theme</option>
            <option value="dark">Dark</option>
            <option value="light">Light</option>
            <option value="satellite">Satellite (Esri)</option>
          </select>
        </div>

        <div class="globe-flux">
          <span class="field__label">Flux size</span>
          <div class="globe-flux__row">
            <span class="globe-legend__circle" style="width:6px;height:6px;"></span>
            <span class="globe-legend__circle" style="width:10px;height:10px;"></span>
            <span class="globe-legend__circle" style="width:15px;height:15px;"></span>
            <span>kg/h</span>
          </div>
        </div>
      </div>

      <div id="sample-viewer" class="sample-viewer" style="display:none">
        <div id="sample-viewer-body" class="sample-viewer__body"></div>
      </div>

      <div id="layer-panel" class="layer-panel" style="display:none">
        <div id="layer-panel-body"></div>
      </div>

      <button id="globe-fullscreen" class="globe-fs" type="button" aria-label="Toggle fullscreen" title="Fullscreen">
        <svg class="fs-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
        </svg>
        <svg class="fs-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" />
        </svg>
      </button>
    </div>
  )}
</div>

<style>
  .globe-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .globe {
    position: absolute;
    inset: 0;
    background: var(--globe-bg);
  }
  .globe-fs {
    position: absolute;
    top: 20px;
    right: 20px;
    pointer-events: auto;
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--panel-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    color: var(--muted);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .globe-fs:hover {
    color: var(--accent-text);
    border-color: var(--accent-line);
  }
  .globe-fs svg {
    width: 18px;
    height: 18px;
  }
  .globe-fs .fs-close {
    display: none;
  }
  .globe-wrap:fullscreen {
    background: var(--bg);
  }
  .globe-wrap:fullscreen .globe-fs {
    top: 24px;
    right: 24px;
  }
  .globe-wrap:fullscreen .globe-fs .fs-open {
    display: none;
  }
  .globe-wrap:fullscreen .globe-fs .fs-close {
    display: block;
  }
  .globe-ui {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .globe-panel {
    position: absolute;
    top: 80px;
    left: 20px;
    min-width: 230px;
    max-height: calc(100% - 100px);
    overflow-y: auto;
    overscroll-behavior: contain;
    pointer-events: auto;
    background: var(--panel-bg);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    padding: 15px 16px;
    font-size: 0.85rem;
    color: var(--muted);
    box-shadow: var(--shadow-lg);
    animation: panel-in 0.5s var(--ease-out) both;
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .globe-panel__title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 8px;
  }
  .globe-check {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 7px;
    margin: 0 -7px;
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .globe-check:hover {
    background: var(--accent-soft);
    color: var(--text);
  }
  .globe-check input {
    accent-color: var(--teal);
    cursor: pointer;
  }
  .globe-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
    flex: none;
    box-shadow: 0 0 0 3px rgba(148, 163, 184, 0.12);
  }
  .globe-select {
    width: 100%;
    background: var(--panel-solid);
    color: var(--text);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-xs);
    padding: 7px 26px 7px 9px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    cursor: pointer;
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%),
      linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position: calc(100% - 15px) 50%, calc(100% - 10px) 50%;
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
    transition: border-color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
  }
  .globe-select:hover {
    border-color: var(--accent-line);
  }
  .globe-row {
    display: flex;
    gap: 10px;
  }
  .globe-row > div {
    flex: 1;
  }
  .globe-count {
    margin: 12px 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--teal-light);
  }
  .globe-flux {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .globe-flux__row {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--slate);
  }
  .globe-legend__circle {
    border-radius: 50%;
    border: 1px solid var(--orange);
    display: inline-block;
    flex: none;
  }
  .sample-viewer {
    position: absolute;
    top: 80px;
    right: 20px;
    width: 268px;
    max-height: calc(100% - 100px);
    overflow-y: auto;
    overscroll-behavior: contain;
    pointer-events: auto;
    background: var(--panel-bg);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    padding: 15px 16px;
    font-size: 0.85rem;
    color: var(--muted);
    box-shadow: var(--shadow-lg);
    animation: panel-in 0.45s var(--ease-out) both;
  }
  .sample-viewer :global(.sv-title) {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--text);
    margin: 0 0 4px;
  }
  .sample-viewer :global(.sv-status) {
    margin: 0 0 10px;
    font-size: 0.78rem;
  }
  .sample-viewer :global(.sv-error) {
    color: var(--orange);
  }
  .sample-viewer :global(.sv-nav) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .sample-viewer :global(.sv-nav__btn) {
    background: transparent;
    border: 1px solid var(--line-strong);
    color: var(--text);
    border-radius: var(--radius-xs);
    width: 30px;
    height: 30px;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .sample-viewer :global(.sv-nav__btn:hover) {
    border-color: var(--teal);
    color: var(--teal-light);
    background: var(--accent-soft);
  }
  .sample-viewer :global(.sv-nav__btn:active) {
    transform: scale(0.92);
  }
  .sample-viewer :global(.sv-nav__pos) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--slate);
  }
  .sample-viewer :global(.sv-assets) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 8px;
  }
  .sample-viewer :global(.sv-asset) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    cursor: pointer;
    font-size: 0.82rem;
    color: var(--text);
    transition: border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .sample-viewer :global(.sv-asset:hover) {
    border-color: var(--teal);
    background: var(--accent-soft);
  }
  .sample-viewer :global(.sv-asset input) {
    accent-color: var(--teal);
  }
  .sample-viewer :global(.sv-asset__state) {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--slate);
  }
  .sample-viewer :global(.sv-asset__state.is-error) {
    color: var(--orange);
  }
  .sample-viewer :global(.sv-item) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 0;
    border-top: 1px solid var(--line);
  }
  .sample-viewer :global(.sv-item input) {
    accent-color: var(--teal);
  }
  .sample-viewer :global(.sv-item__text) {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .sample-viewer :global(.sv-item__text b) {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text);
  }
  .sample-viewer :global(.sv-item__text span) {
    font-size: 0.7rem;
    color: var(--slate);
  }
  .sample-viewer :global(.sv-remove) {
    background: transparent;
    border: none;
    color: var(--muted);
    cursor: pointer;
    font-size: 1.1rem;
    line-height: 1;
    padding: 0 2px;
    transition: color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .sample-viewer :global(.sv-remove:hover) {
    color: var(--orange);
    transform: scale(1.15);
  }
  .sample-viewer :global(.sv-clear) {
    margin-top: 8px;
    background: transparent;
    border: 1px solid var(--line-strong);
    color: var(--muted);
    border-radius: var(--radius-xs);
    padding: 5px 10px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .sample-viewer :global(.sv-clear:hover) {
    border-color: var(--teal);
    color: var(--teal-light);
    background: var(--accent-soft);
  }
  .layer-panel {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: 300px;
    max-height: 42%;
    overflow-y: auto;
    overscroll-behavior: contain;
    pointer-events: auto;
    background: var(--panel-bg);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    padding: 15px 16px;
    font-size: 0.85rem;
    color: var(--muted);
    box-shadow: var(--shadow-lg);
    animation: panel-in 0.45s var(--ease-out) both;
  }
  .layer-panel :global(.lp-item) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px 8px;
    padding: 9px 0;
    border-top: 1px solid var(--line);
  }
  .layer-panel :global(.lp-item__text) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .layer-panel :global(.lp-item__text b) {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text);
  }
  .layer-panel :global(.lp-item__text span) {
    font-size: 0.7rem;
    color: var(--slate);
  }
  .layer-panel :global(.lp-item__chips) {
    display: flex;
    gap: 4px;
    grid-column: 1 / -1;
  }
  .layer-panel :global(.lp-chip) {
    background: transparent;
    border: 1px solid var(--line-strong);
    color: var(--slate);
    border-radius: var(--radius-pill);
    padding: 3px 9px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .layer-panel :global(.lp-chip:hover) {
    color: var(--text);
    border-color: var(--accent-line);
  }
  .layer-panel :global(.lp-chip.is-on) {
    border-color: var(--teal);
    color: var(--teal-light);
    background: var(--accent-soft);
  }
  .layer-panel :global(.lp-item__actions) {
    display: flex;
    gap: 2px;
  }
  .layer-panel :global(.lp-icon) {
    background: transparent;
    border: none;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1;
    padding: 2px 4px;
    transition: color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }
  .layer-panel :global(.lp-icon:hover) {
    color: var(--teal-light);
    transform: scale(1.12);
  }
  .globe-count {
    transition: color var(--dur) var(--ease);
  }
  @media (max-width: 720px) {
    .globe-panel {
      top: 12px;
      left: 12px;
      max-width: calc(100% - 24px);
      /* leave most of the map visible: the panel is a filter, not the content */
      max-height: 48%;
      font-size: 0.82rem;
    }
    .sample-viewer,
    .layer-panel {
      display: none !important;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .globe-panel,
    .sample-viewer,
    .layer-panel {
      animation: none;
    }
  }
</style>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import { url } from "../lib/url";
  import { openInspector, reAddAll } from "../lib/sampleViewer";

  const SENSOR_COLOR = {
    EMIT: "#f97316",
    "Sentinel-2": "#2dd4bf",
    "Landsat 8/9": "#fde047",
  };

  const BASEMAPS: Record<string, any> = {
    dark: "https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json",
    light: "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
    satellite: {
      version: 8,
      sources: {
        sat: {
          type: "raster",
          tiles: [
            "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
          ],
          tileSize: 256,
          maxzoom: 19,
          attribution: "Imagery © Esri, Maxar, Earthstar Geographics",
        },
      },
      layers: [
        {
          id: "sat",
          type: "raster",
          source: "sat",
          paint: { "raster-fade-duration": 0, "raster-resampling": "linear" },
        },
      ],
    },
  };

  const el = document.getElementById("globe");
  if (el) {
    const allowZoom = el.dataset.scrollZoom === "true";
    const rotate = el.dataset.rotate === "true";
    const controls = el.dataset.controls === "true";
    const focusRight = el.dataset.focusRight === "true";

    const theme = () => document.documentElement.getAttribute("data-theme") || "dark";
    const autoBasemap = () => (theme() === "light" ? "light" : "dark");

    const map = new maplibregl.Map({
      container: el,
      style: BASEMAPS[autoBasemap()],
      center: [30, 20],
      zoom: 0.75,
      attributionControl: false,
      scrollZoom: allowZoom,
      dragRotate: false,
    });

    let plumeData: any = null;
    let visibleFeatures: any[] = [];
    let basemapChoice = "auto";

    (window as any).__map = map;

    if (focusRight) {
      const applyPadding = () => map.setPadding({ left: Math.round(el.clientWidth * 0.42) });
      map.on("load", applyPadding);
      map.on("resize", applyPadding);
    }

    const fsButton = document.getElementById("globe-fullscreen");
    const wrap = el.closest(".globe-wrap");
    fsButton?.addEventListener("click", () => {
      if (document.fullscreenElement) {
        document.exitFullscreen();
      } else {
        wrap?.requestFullscreen?.();
      }
    });
    document.addEventListener("fullscreenchange", () => {
      map.resize();
      window.setTimeout(() => map.resize(), 150);
    });

    const popup = new maplibregl.Popup({
      closeButton: false,
      closeOnClick: false,
      offset: 12,
      className: "plume-popup",
      maxWidth: "280px",
    });

    const colorExpr = [
      "match",
      ["get", "sensor"],
      "EMIT", SENSOR_COLOR.EMIT,
      "Sentinel-2", SENSOR_COLOR["Sentinel-2"],
      "Landsat 8/9", SENSOR_COLOR["Landsat 8/9"],
      "#94a3b8",
    ];

    const ensureLayers = () => {
      if (!plumeData || map.getLayer("plumes")) return;

      try {
        map.addSource("plumes", { type: "geojson", data: plumeData });
      } catch (e) {
        return;
      }

      map.addLayer({
        id: "plumes-halo",
        type: "circle",
        source: "plumes",
        paint: {
          "circle-radius": [
            "interpolate",
            ["linear"],
            ["coalesce", ["get", "flux"], 0],
            0, 9,
            5000, 14,
            20000, 22,
          ],
          "circle-color": colorExpr as any,
          "circle-opacity": 0.14,
          "circle-blur": 1,
        },
      });

      map.addLayer({
        id: "plumes",
        type: "circle",
        source: "plumes",
        paint: {
          "circle-radius": [
            "interpolate",
            ["linear"],
            ["coalesce", ["get", "flux"], 0],
            0, 2.2,
            5000, 4.5,
            20000, 7.5,
          ],
          "circle-color": colorExpr as any,
          "circle-opacity": 0.92,
          "circle-stroke-color": "rgba(2,6,23,0.6)",
          "circle-stroke-width": 0.4,
        },
      });

      const fmt = (v: number | null) => (v == null ? "n/a" : `${Math.round(v).toLocaleString()} kg/h`);

      map.on("mouseenter", "plumes", (e) => {
        map.getCanvas().style.cursor = "pointer";
        const f = (e.features && e.features[0]) as any;
        if (!f) return;
        const p = f.properties;
        const color = SENSOR_COLOR[p.sensor as keyof typeof SENSOR_COLOR] ?? "#94a3b8";
        const extra =
          p.n_imeo != null
            ? `<div class="pp-row"><span>IMEO plumes</span><b>${p.n_imeo}</b></div>` +
              `<div class="pp-row"><span>Carbon Mapper</span><b>${p.n_cm}</b></div>`
            : "";
        const sector = p.sector ? `<div class="pp-row"><span>Sector</span><b>${p.sector}</b></div>` : "";
        popup
          .setLngLat(f.geometry.coordinates)
          .setHTML(
            `<div class="pp"><span class="pp-sensor" style="color:${color}">${p.sensor}</span>` +
              `<h4>${p.country ?? "Unknown"}</h4>` +
              `<div class="pp-row"><span>Dataset</span><b>${p.dataset}</b></div>` +
              `<div class="pp-row"><span>Date</span><b>${p.date || "n/a"}</b></div>` +
              `<div class="pp-row"><span>Flux</span><b>${fmt(p.flux)}</b></div>` +
              sector +
              extra +
              `</div>`,
          )
          .addTo(map);
      });

      map.on("mouseleave", "plumes", () => {
        map.getCanvas().style.cursor = "";
        popup.remove();
      });

      map.on("click", "plumes", (e) => {
        const f = (e.features && e.features[0]) as any;
        if (!f) return;
        const root = document.getElementById("sample-viewer");
        const bodyEl = document.getElementById("sample-viewer-body");
        const layersRoot = document.getElementById("layer-panel");
        const layersBody = document.getElementById("layer-panel-body");
        if (!root || !bodyEl || !layersRoot || !layersBody) return;
        openInspector(
          map,
          { properties: f.properties, geometry: f.geometry },
          { root, body: bodyEl, layersRoot, layersBody, list: visibleFeatures },
        );
      });

      reAddAll(map);
      applyFilters();
    };

    map.on("style.load", () => {
      if (typeof (map as any).setProjection === "function") {
        (map as any).setProjection({ type: "globe" });
      }
      ensureLayers();
    });

    map.on("idle", ensureLayers);

    const setBasemap = (name: string) => {
      basemapChoice = name;
      const resolved = name === "auto" ? autoBasemap() : name;
      map.setStyle(BASEMAPS[resolved]);
    };

    if (rotate) {
      let lng = 30;
      const spin = () => {
        lng += 0.35;
        map.easeTo({ center: [lng, 20], duration: 1200, easing: (t) => t });
      };
      map.once("load", () => {
        const timer = setInterval(spin, 1200);
        const stop = () => clearInterval(timer);
        map.once("mousedown", stop);
        map.once("touchstart", stop);
        map.once("wheel", stop);
      });
    }

    new MutationObserver(() => {
      if (basemapChoice === "auto") setBasemap("auto");
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    let applyFilters = () => {};

    fetch(url("data/plumes.geojson"))
      .then((r) => r.json())
      .then((geojson) => {
        plumeData = geojson;

        if (controls) {
          const boxes = Array.from(document.querySelectorAll<HTMLInputElement>("[data-sensor]"));
          const countrySel = document.getElementById("country-select") as HTMLSelectElement | null;
          const yearFrom = document.getElementById("year-from") as HTMLSelectElement | null;
          const yearTo = document.getElementById("year-to") as HTMLSelectElement | null;
          const fluxMin = document.getElementById("flux-min") as HTMLSelectElement | null;
          const basemapSel = document.getElementById("basemap-select") as HTMLSelectElement | null;
          const count = document.getElementById("globe-count");

          const countries = Array.from(
            new Set(geojson.features.map((f: any) => f.properties.country).filter(Boolean)),
          ).sort() as string[];
          if (countrySel) {
            for (const c of countries) {
              const opt = document.createElement("option");
              opt.value = c;
              opt.textContent = c;
              countrySel.appendChild(opt);
            }
          }

          applyFilters = () => {
            if (!map.getLayer("plumes")) return;
            const sensors = boxes.filter((b) => b.checked).map((b) => b.value);
            const country = countrySel?.value ?? "";
            const from = yearFrom?.value ?? "2018";
            const to = yearTo?.value ?? "2025";
            const minFlux = Number(fluxMin?.value ?? 0);

            const filters: any[] = [["in", ["get", "sensor"], ["literal", sensors]]];
            if (country) filters.push(["==", ["get", "country"], country]);
            filters.push([">=", ["slice", ["get", "date"], 0, 4], from]);
            filters.push(["<=", ["slice", ["get", "date"], 0, 4], to]);
            if (minFlux > 0) filters.push([">=", ["coalesce", ["get", "flux"], 0], minFlux]);

            map.setFilter("plumes", ["all", ...filters]);
            map.setFilter("plumes-halo", ["all", ...filters]);

            visibleFeatures = geojson.features.filter((f: any) => {
              const p = f.properties;
              const y = (p.date || "").slice(0, 4);
              return (
                sensors.includes(p.sensor) &&
                (!country || p.country === country) &&
                y >= from &&
                y <= to &&
                (minFlux === 0 || (p.flux ?? 0) >= minFlux)
              );
            });
            if (count) count.textContent = `${visibleFeatures.length.toLocaleString()} samples shown`;
          };

          boxes.forEach((b) => b.addEventListener("change", applyFilters));
          [countrySel, yearFrom, yearTo, fluxMin].forEach((s) => s?.addEventListener("change", applyFilters));
          basemapSel?.addEventListener("change", () => setBasemap(basemapSel.value));
        }

        ensureLayers();
      })
      .catch((err) => console.error("plumes.geojson:", err));
  }
</script>
