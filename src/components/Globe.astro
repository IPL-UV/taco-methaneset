---
interface Props {
  scrollZoom?: boolean;
  controls?: boolean;
  rotate?: boolean;
}
const { scrollZoom = false, controls = false, rotate = false } = Astro.props;

const sensors = [
  { id: "EMIT", color: "#f97316", label: "EMIT · hyperspectral" },
  { id: "Sentinel-2", color: "#2dd4bf", label: "Sentinel-2 · multispectral" },
  { id: "Landsat 8/9", color: "#fde047", label: "Landsat 8/9 · multispectral" },
];

const years = ["2018", "2019", "2020", "2021", "2022", "2023", "2024", "2025"];
---

<div class="globe-wrap">
  <div
    id="globe"
    class="globe"
    data-scroll-zoom={scrollZoom ? "true" : "false"}
    data-rotate={rotate ? "true" : "false"}
    data-controls={controls ? "true" : "false"}></div>

  {controls && (
    <div class="globe-ui">
      <div class="globe-panel">
        <p class="globe-panel__title">Sensors</p>
        {
          sensors.map((s) => (
            <label class="globe-check">
              <input type="checkbox" value={s.id} checked data-sensor />
              <span class="globe-dot" style={`background:${s.color}`} />
              {s.label}
            </label>
          ))
        }

        <p class="globe-panel__title" style="margin-top:14px;">Country</p>
        <select id="country-select" class="globe-select">
          <option value="">All countries</option>
        </select>

        <div class="globe-row">
          <div>
            <p class="globe-panel__title" style="margin-top:14px;">From</p>
            <select id="year-from" class="globe-select">
              {years.map((y) => <option value={y}>{y}</option>)}
            </select>
          </div>
          <div>
            <p class="globe-panel__title" style="margin-top:14px;">To</p>
            <select id="year-to" class="globe-select">
              {years.map((y) => <option value={y} selected={y === "2025"}>{y}</option>)}
            </select>
          </div>
        </div>

        <p class="globe-panel__title" style="margin-top:14px;">Min flux</p>
        <select id="flux-min" class="globe-select">
          <option value="0">Any</option>
          <option value="1000">≥ 1,000 kg/h</option>
          <option value="5000">≥ 5,000 kg/h</option>
          <option value="10000">≥ 10,000 kg/h</option>
        </select>

        <p class="globe-panel__title" style="margin-top:14px;">Basemap</p>
        <select id="basemap-select" class="globe-select">
          <option value="auto">Match theme</option>
          <option value="dark">Dark</option>
          <option value="light">Light</option>
          <option value="satellite">Satellite</option>
        </select>

        <p id="globe-count" class="globe-count"></p>
      </div>

      <div class="globe-legend">
        <p class="globe-panel__title">Legend</p>
        {
          sensors.map((s) => (
            <div class="globe-legend__row">
              <span class="globe-dot" style={`background:${s.color}`} />
              {s.id}
            </div>
          ))
        }
        <div class="globe-legend__size">
          <span class="globe-legend__circle" style="width:6px;height:6px;" />
          <span class="globe-legend__circle" style="width:11px;height:11px;" />
          <span class="globe-legend__circle" style="width:16px;height:16px;" />
          <span>flux · kg/h</span>
        </div>
      </div>

      <div id="sample-viewer" class="sample-viewer" style="display:none">
        <div id="sample-viewer-body" class="sample-viewer__body"></div>
      </div>
    </div>
  )}
</div>

<style>
  .globe-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .globe {
    position: absolute;
    inset: 0;
    background: var(--globe-bg);
  }
  .globe-ui {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .globe-panel,
  .globe-legend {
    position: absolute;
    pointer-events: auto;
    background: var(--panel-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px 16px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .globe-panel {
    top: 80px;
    left: 20px;
    min-width: 230px;
    max-height: calc(100% - 100px);
    overflow-y: auto;
  }
  .globe-legend {
    bottom: 20px;
    right: 20px;
  }
  .globe-panel__title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal);
    margin: 0 0 8px;
  }
  .globe-check {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    cursor: pointer;
  }
  .globe-check input {
    accent-color: var(--teal);
  }
  .globe-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
    flex: none;
  }
  .globe-select {
    width: 100%;
    background: var(--panel-solid);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 6px 8px;
    font-family: var(--font-body);
    font-size: 0.85rem;
  }
  .globe-row {
    display: flex;
    gap: 10px;
  }
  .globe-row > div {
    flex: 1;
  }
  .globe-count {
    margin: 12px 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--teal-light);
  }
  .globe-legend__row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 3px 0;
  }
  .globe-legend__size {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }
  .globe-legend__circle {
    border-radius: 50%;
    border: 1px solid var(--orange);
    display: inline-block;
  }
  .sample-viewer {
    position: absolute;
    top: 80px;
    right: 20px;
    width: 260px;
    pointer-events: auto;
    background: var(--panel-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px 16px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .sample-viewer :global(.sv-title) {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--text);
    margin: 0 0 4px;
  }
  .sample-viewer :global(.sv-status) {
    margin: 0 0 10px;
    font-size: 0.78rem;
  }
  .sample-viewer :global(.sv-error) {
    color: var(--orange);
  }
  .sample-viewer :global(.sv-clear) {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--muted);
    border-radius: 8px;
    padding: 5px 10px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .sample-viewer :global(.sv-clear:hover) {
    border-color: var(--teal);
    color: var(--teal-light);
  }
  @media (max-width: 720px) {
    .globe-legend {
      display: none;
    }
    .globe-panel {
      top: 12px;
      left: 12px;
    }
    .sample-viewer {
      display: none !important;
    }
  }
</style>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import { url } from "../lib/url";
  import { showSample, redrawSample } from "../lib/sampleViewer";

  const SENSOR_COLOR = {
    EMIT: "#f97316",
    "Sentinel-2": "#2dd4bf",
    "Landsat 8/9": "#fde047",
  };

  const BASEMAPS: Record<string, any> = {
    dark: "https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json",
    light: "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
    satellite: {
      version: 8,
      sources: {
        sat: {
          type: "raster",
          tiles: [
            "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
          ],
          tileSize: 256,
          attribution: "Imagery © Esri, Maxar, Earthstar Geographics",
        },
      },
      layers: [{ id: "sat", type: "raster", source: "sat" }],
    },
  };

  const el = document.getElementById("globe");
  if (el) {
    const allowZoom = el.dataset.scrollZoom === "true";
    const rotate = el.dataset.rotate === "true";
    const controls = el.dataset.controls === "true";

    const theme = () => document.documentElement.getAttribute("data-theme") || "dark";
    const autoBasemap = () => (theme() === "light" ? "light" : "dark");

    const map = new maplibregl.Map({
      container: el,
      style: BASEMAPS[autoBasemap()],
      center: [30, 20],
      zoom: 0.75,
      attributionControl: false,
      scrollZoom: allowZoom,
      dragRotate: false,
    });

    let plumeData: any = null;
    let basemapChoice = "auto";

    (window as any).__map = map;

    const popup = new maplibregl.Popup({
      closeButton: false,
      closeOnClick: false,
      offset: 12,
      className: "plume-popup",
      maxWidth: "280px",
    });

    const colorExpr = [
      "match",
      ["get", "sensor"],
      "EMIT", SENSOR_COLOR.EMIT,
      "Sentinel-2", SENSOR_COLOR["Sentinel-2"],
      "Landsat 8/9", SENSOR_COLOR["Landsat 8/9"],
      "#94a3b8",
    ];

    const ensureLayers = () => {
      if (!plumeData || map.getLayer("plumes")) return;

      try {
        map.addSource("plumes", { type: "geojson", data: plumeData });
      } catch (e) {
        return;
      }

      map.addLayer({
        id: "plumes-halo",
        type: "circle",
        source: "plumes",
        paint: {
          "circle-radius": [
            "interpolate",
            ["linear"],
            ["coalesce", ["get", "flux"], 0],
            0, 9,
            5000, 14,
            20000, 22,
          ],
          "circle-color": colorExpr as any,
          "circle-opacity": 0.14,
          "circle-blur": 1,
        },
      });

      map.addLayer({
        id: "plumes",
        type: "circle",
        source: "plumes",
        paint: {
          "circle-radius": [
            "interpolate",
            ["linear"],
            ["coalesce", ["get", "flux"], 0],
            0, 2.2,
            5000, 4.5,
            20000, 7.5,
          ],
          "circle-color": colorExpr as any,
          "circle-opacity": 0.92,
          "circle-stroke-color": "rgba(2,6,23,0.6)",
          "circle-stroke-width": 0.4,
        },
      });

      const fmt = (v: number | null) => (v == null ? "n/a" : `${Math.round(v).toLocaleString()} kg/h`);

      map.on("mouseenter", "plumes", (e) => {
        map.getCanvas().style.cursor = "pointer";
        const f = (e.features && e.features[0]) as any;
        if (!f) return;
        const p = f.properties;
        const color = SENSOR_COLOR[p.sensor as keyof typeof SENSOR_COLOR] ?? "#94a3b8";
        const extra =
          p.n_imeo != null
            ? `<div class="pp-row"><span>IMEO plumes</span><b>${p.n_imeo}</b></div>` +
              `<div class="pp-row"><span>Carbon Mapper</span><b>${p.n_cm}</b></div>`
            : "";
        const sector = p.sector ? `<div class="pp-row"><span>Sector</span><b>${p.sector}</b></div>` : "";
        popup
          .setLngLat(f.geometry.coordinates)
          .setHTML(
            `<div class="pp"><span class="pp-sensor" style="color:${color}">${p.sensor}</span>` +
              `<h4>${p.country ?? "Unknown"}</h4>` +
              `<div class="pp-row"><span>Dataset</span><b>${p.dataset}</b></div>` +
              `<div class="pp-row"><span>Date</span><b>${p.date || "n/a"}</b></div>` +
              `<div class="pp-row"><span>Flux</span><b>${fmt(p.flux)}</b></div>` +
              sector +
              extra +
              `</div>`,
          )
          .addTo(map);
      });

      map.on("mouseleave", "plumes", () => {
        map.getCanvas().style.cursor = "";
        popup.remove();
      });

      map.on("click", "plumes", (e) => {
        const f = (e.features && e.features[0]) as any;
        if (!f) return;
        const root = document.getElementById("sample-viewer");
        const bodyEl = document.getElementById("sample-viewer-body");
        if (!root || !bodyEl) return;
        const p = f.properties;
        if (p.viz === "multispectral") {
          showSample(map, p, { root, body: bodyEl });
        } else {
          root.style.display = "block";
          bodyEl.innerHTML =
            `<p class="sv-title">${p.sensor} · ${p.country ?? ""}</p>` +
            `<p class="sv-status">${p.dataset} · ${p.date || ""}</p>` +
            `<p class="sv-status">EMIT is stored in sensor coordinates, so it cannot be drawn on the map yet. Coming next.</p>` +
            `<button class="sv-clear" type="button">Close</button>`;
          bodyEl.querySelector(".sv-clear")?.addEventListener("click", () => {
            root.style.display = "none";
          });
        }
      });

      redrawSample(map);
      applyFilters();
    };

    map.on("style.load", () => {
      if (typeof (map as any).setProjection === "function") {
        (map as any).setProjection({ type: "globe" });
      }
      ensureLayers();
    });

    map.on("idle", ensureLayers);

    const setBasemap = (name: string) => {
      basemapChoice = name;
      const resolved = name === "auto" ? autoBasemap() : name;
      map.setStyle(BASEMAPS[resolved]);
    };

    if (rotate) {
      let lng = 30;
      const spin = () => {
        lng += 0.35;
        map.easeTo({ center: [lng, 20], duration: 1200, easing: (t) => t });
      };
      map.once("load", () => {
        const timer = setInterval(spin, 1200);
        const stop = () => clearInterval(timer);
        map.once("mousedown", stop);
        map.once("touchstart", stop);
        map.once("wheel", stop);
      });
    }

    new MutationObserver(() => {
      if (basemapChoice === "auto") setBasemap("auto");
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    let applyFilters = () => {};

    fetch(url("data/plumes.geojson"))
      .then((r) => r.json())
      .then((geojson) => {
        plumeData = geojson;

        if (controls) {
          const boxes = Array.from(document.querySelectorAll<HTMLInputElement>("[data-sensor]"));
          const countrySel = document.getElementById("country-select") as HTMLSelectElement | null;
          const yearFrom = document.getElementById("year-from") as HTMLSelectElement | null;
          const yearTo = document.getElementById("year-to") as HTMLSelectElement | null;
          const fluxMin = document.getElementById("flux-min") as HTMLSelectElement | null;
          const basemapSel = document.getElementById("basemap-select") as HTMLSelectElement | null;
          const count = document.getElementById("globe-count");

          const countries = Array.from(
            new Set(geojson.features.map((f: any) => f.properties.country).filter(Boolean)),
          ).sort() as string[];
          if (countrySel) {
            for (const c of countries) {
              const opt = document.createElement("option");
              opt.value = c;
              opt.textContent = c;
              countrySel.appendChild(opt);
            }
          }

          applyFilters = () => {
            if (!map.getLayer("plumes")) return;
            const sensors = boxes.filter((b) => b.checked).map((b) => b.value);
            const country = countrySel?.value ?? "";
            const from = yearFrom?.value ?? "2018";
            const to = yearTo?.value ?? "2025";
            const minFlux = Number(fluxMin?.value ?? 0);

            const filters: any[] = [["in", ["get", "sensor"], ["literal", sensors]]];
            if (country) filters.push(["==", ["get", "country"], country]);
            filters.push([">=", ["slice", ["get", "date"], 0, 4], from]);
            filters.push(["<=", ["slice", ["get", "date"], 0, 4], to]);
            if (minFlux > 0) filters.push([">=", ["coalesce", ["get", "flux"], 0], minFlux]);

            map.setFilter("plumes", ["all", ...filters]);
            map.setFilter("plumes-halo", ["all", ...filters]);

            const visible = geojson.features.filter((f: any) => {
              const p = f.properties;
              const y = (p.date || "").slice(0, 4);
              return (
                sensors.includes(p.sensor) &&
                (!country || p.country === country) &&
                y >= from &&
                y <= to &&
                (minFlux === 0 || (p.flux ?? 0) >= minFlux)
              );
            }).length;
            if (count) count.textContent = `${visible.toLocaleString()} plumes shown`;
          };

          boxes.forEach((b) => b.addEventListener("change", applyFilters));
          [countrySel, yearFrom, yearTo, fluxMin].forEach((s) => s?.addEventListener("change", applyFilters));
          basemapSel?.addEventListener("change", () => setBasemap(basemapSel.value));
        }

        ensureLayers();
      })
      .catch((err) => console.error("plumes.geojson:", err));
  }
</script>
