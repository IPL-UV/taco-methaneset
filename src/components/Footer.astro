---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const url = (p = "") => `${base}${p.replace(/^\/+/, "")}`;

const links = [
  { label: "Data", href: url("data/") },
  { label: "Papers", href: url("paper/") },
  { label: "Code", href: url("code/") },
  { label: "About", href: url("project/") },
  { label: "GitHub", href: "https://github.com/IPL-UV/taco-methaneset", external: true },
  { label: "Hugging Face", href: "https://huggingface.co/datasets/tacofoundation/methaneset", external: true },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <a class="footer__mark" href={base}>
      <span class="footer__dot"></span>
      MethaneSET
    </a>

    <p class="footer__tagline">
      Multi-sensor, AI-ready methane datasets from Sentinel-2, Landsat 8/9 and EMIT,
      built on the TACO specification.
    </p>

    <nav class="footer__nav" aria-label="Footer">
      {
        links.map((l) => (
          <a
            href={l.href}
            target={l.external ? "_blank" : undefined}
            rel={l.external ? "noopener" : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="footer__meta">
      <span>© {year} MethaneSET</span>
      <span>Image and Signal Processing Group, Universitat de València</span>
      <span>Data CC-BY-NC-SA 4.0, plume bank CC-BY 4.0</span>
      <span>
        Funded by
        <a href="https://www.climatechange.ai" target="_blank" rel="noopener">CCAI</a>
        and the
        <a href="https://www.globalmethanehub.org" target="_blank" rel="noopener">Global Methane Hub</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: 40px;
  }
  .footer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(560px, 80%);
    height: 1px;
    background: var(--gradient-strong, var(--gradient));
    opacity: 0.55;
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 64px 24px 56px;
  }
  .footer__mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--text);
    margin-bottom: 14px;
  }
  .footer__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--gradient-strong, var(--gradient));
  }
  .footer__tagline {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 52ch;
    margin: 0 0 26px;
  }
  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 26px;
    margin-bottom: 30px;
  }
  .footer__nav a {
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .footer__nav a:hover {
    color: var(--accent-text);
  }
  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 20px;
    color: var(--slate);
    font-size: 0.8rem;
    max-width: 72ch;
  }
  .footer__meta a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
