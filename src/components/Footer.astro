---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const funders = [
  { src: "uv.svg", alt: "Universitat de València", href: "https://www.uv.es" },
  { src: "upv.svg", alt: "Universitat Politècnica de València", href: "https://www.upv.es" },
  { src: "leipzig.svg", alt: "Leipzig University", href: "https://www.uni-leipzig.de" },
  { src: "gmh.png", alt: "Global Methane Hub", href: "https://www.globalmethanehub.org" },
  { src: "ccai.png", alt: "Climate Change AI", href: "https://www.climatechange.ai" },
];
---

<footer class="footer">
  <div class="container footer__funders">
    {
      funders.map((f) => (
        <a class="footer__funder" href={f.href} target="_blank" rel="noopener" title={f.alt}>
          <img src={`${base}logos/${f.src}`} alt={f.alt} loading="lazy" />
        </a>
      ))
    }
  </div>
  <div class="container footer__row">
    <div class="footer__brand">
      <a class="footer__isp" href="https://isp.uv.es" target="_blank" rel="noopener" title="ISP, Universitat de València">
        <img src={`${base}logos/isp.png`} alt="ISP, Universitat de València" loading="lazy" />
      </a>
      <span>
        <strong>MethaneSET</strong>
        Image and Signal Processing Group, Universitat de València
      </span>
    </div>
    <div class="footer__links">
      <a href="https://github.com/IPL-UV/taco-methaneset" target="_blank" rel="noopener">GitHub</a>
      <a href="https://huggingface.co/datasets/tacofoundation/methaneset" target="_blank" rel="noopener"
        >Hugging Face</a
      >
      <span>CC-BY-NC-SA 4.0</span>
    </div>
    <div>© {year}. Funded by CCAI and the Global Methane Hub.</div>
  </div>
</footer>

<style>
  .footer__funders {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 30px;
  }
  .footer__funder {
    background: #ffffff;
    border-radius: var(--radius-xs);
    padding: 8px 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 68px;
    min-width: 128px;
    transition: transform 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  .footer__funder:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28);
  }
  .footer__funder img {
    max-height: 42px;
    max-width: 100%;
    object-fit: contain;
  }
  .footer__brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .footer__brand span {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }
  .footer__brand strong {
    font-family: var(--font-display);
    color: var(--text);
  }
  .footer__isp {
    background: #ffffff;
    border-radius: var(--radius-xs);
    padding: 5px 7px;
    display: inline-flex;
    align-items: center;
  }
  .footer__isp img {
    height: 30px;
    width: auto;
    display: block;
  }
  .footer__links {
    display: flex;
    align-items: center;
    gap: 18px;
  }
</style>
