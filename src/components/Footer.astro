---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const url = (p = "") => `${base}${p.replace(/^\/+/, "")}`;

const links = [
  { label: "Data", href: url("data/") },
  { label: "TACO", href: url("taco/") },
  { label: "Papers", href: url("paper/") },
  { label: "Code", href: url("code/") },
  { label: "Project", href: url("project/") },
  { label: "GitHub", href: "https://github.com/IPL-UV/taco-methaneset", external: true },
  { label: "Hugging Face", href: "https://huggingface.co/datasets/tacofoundation/methaneset", external: true },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <a class="footer__mark" href={base}>Methane<em>SET</em></a>

    <p class="footer__tagline">
      Multi-sensor, AI-ready methane datasets from Sentinel-2, Landsat 8/9 and EMIT,
      built on the TACO specification.
    </p>

    <nav class="footer__nav" aria-label="Footer">
      {
        links.map((l) => (
          <a
            href={l.href}
            target={l.external ? "_blank" : undefined}
            rel={l.external ? "noopener" : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="footer__meta">
      <p>Image and Signal Processing Group, Universitat de València</p>
      <p>
        Funded by
        <a href="https://www.climatechange.ai" target="_blank" rel="noopener">CCAI</a>
        and the
        <a href="https://www.globalmethanehub.org" target="_blank" rel="noopener">Global Methane Hub</a>
      </p>
      <p class="footer__legal">
        <span>© {year} MethaneSET</span>
        <span>Data CC-BY-NC-SA 4.0, plume bank CC-BY 4.0</span>
        <span>
          Basemaps
          <a href="https://carto.com/attributions" target="_blank" rel="noopener">CARTO</a>,
          <a href="https://www.esri.com" target="_blank" rel="noopener">Esri</a>,
          <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>
        </span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 64px 24px 60px;
  }
  .footer__mark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.32rem;
    letter-spacing: -0.015em;
    line-height: 1;
    color: var(--text);
    margin-bottom: 16px;
  }
  .footer__mark em {
    font-style: normal;
    color: var(--accent-text);
  }
  .footer__tagline {
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.6;
    max-width: 50ch;
    margin: 0 0 30px;
  }
  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 26px;
    margin-bottom: 26px;
    width: min(100%, 620px);
  }
  .footer__nav a {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 500;
  }
  .footer__nav a:hover {
    color: var(--text);
  }
  .footer__meta {
    color: var(--slate);
    font-size: 0.8rem;
    line-height: 1.7;
    max-width: 64ch;
  }
  .footer__meta p {
    margin: 0;
  }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px 22px;
    margin-top: 10px !important;
  }
  .footer__meta a {
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .footer__meta a:hover {
    color: var(--text);
    text-decoration-color: currentColor;
  }
</style>
