---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const funders = [
  { src: "uv.svg", alt: "Universitat de València", href: "https://www.uv.es" },
  { src: "upv.svg", alt: "Universitat Politècnica de València", href: "https://www.upv.es" },
  { src: "leipzig.svg", alt: "Leipzig University", href: "https://www.uni-leipzig.de" },
  { src: "gmh.png", alt: "Global Methane Hub", href: "https://www.globalmethanehub.org" },
  { src: "ccai.png", alt: "Climate Change AI", href: "https://www.climatechange.ai" },
];
---

<footer class="footer">
  <div class="container footer__funders">
    {
      funders.map((f) => (
        <a class="footer__funder" href={f.href} target="_blank" rel="noopener" title={f.alt}>
          <img src={`${base}logos/${f.src}`} alt={f.alt} loading="lazy" />
        </a>
      ))
    }
  </div>
  <div class="container footer__row">
    <div class="footer__brand">
      <a class="footer__isp" href="https://isp.uv.es" target="_blank" rel="noopener" title="ISP, Universitat de València">
        <img src={`${base}logos/isp.png`} alt="ISP, Universitat de València" loading="lazy" />
      </a>
      <span>
        <strong>MethaneSET</strong>
        Image and Signal Processing Group, Universitat de València
      </span>
    </div>
    <div class="footer__meta">
      <div class="footer__links">
        <a href="https://github.com/IPL-UV/taco-methaneset" target="_blank" rel="noopener">GitHub</a>
        <a href="https://huggingface.co/datasets/tacofoundation/methaneset" target="_blank" rel="noopener"
          >Hugging Face</a
        >
        <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener"
          >CC BY-NC-SA 4.0</a
        >
      </div>
      <p class="footer__legal">© {year} MethaneSET. Funded by CCAI and the Global Methane Hub.</p>
    </div>
  </div>
</footer>

<style>
  .footer__funders {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 12px;
    margin-bottom: 38px;
  }
  .footer__funder {
    /* White tiles on a white page need their own edge in light mode */
    background: #ffffff;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-xs);
    padding: 10px 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 78px;
    min-width: 148px;
    flex: 0 1 auto;
  }
  .footer__funder img {
    max-height: 48px;
    max-width: 100%;
    object-fit: contain;
  }
  .footer__brand {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }
  .footer__brand span {
    display: flex;
    flex-direction: column;
    line-height: 1.4;
  }
  .footer__brand strong {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--text);
  }
  .footer__isp {
    flex: none;
    background: #ffffff;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-xs);
    padding: 6px 9px;
    display: inline-flex;
    align-items: center;
  }
  .footer__isp img {
    height: 34px;
    width: auto;
    display: block;
  }
  .footer__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    text-align: right;
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
  }
  .footer__legal {
    margin: 0;
  }

  @media (max-width: 720px) {
    .footer__meta {
      align-items: flex-start;
      text-align: left;
    }
    .footer__funder {
      height: 68px;
      min-width: 126px;
      flex: 1 1 126px;
    }
    .footer__funder img {
      max-height: 40px;
    }
  }
</style>
