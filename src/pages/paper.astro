    border-top: 1px solid var(--line-strong);
    padding-top: 26px;
    max-width: 78ch;
  }
  .paper__kind {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--slate);
    margin: 0 0 14px;
  }
  .paper__title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.18;
    margin: 0 0 12px;
  }
  .venue {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--slate);
    margin: 0;
  }
  .paper__body {
    max-width: none;
    margin-top: 26px;
  }
  .authors {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text);
    margin: 0 0 12px;
  }
  .affils {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--slate);
  }
  .affils li {
    margin: 0;
  }
  .paper__body h3 {
    margin: 2em 0 0.6em;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text);
  }
  .paper__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
</style>
