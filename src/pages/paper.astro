---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const url = (p = "") => `${base}${p.replace(/^\/+/, "")}`;

const tacoAuthors = [
  "Cesar Aybar",
  "Julio Contreras",
  "Chen Ma",
  "Oscar J. Pellicer-Valero",
  "Gonzalo Mateo-García",
  "Luis Gómez-Chova",
  "Gustau Camps-Valls",
  "Nils Lehmann",
  "Mikolaj Czerkawski",
  "David Montero",
  "Miguel D. Mahecha",
  "Ingrid Aybar",
];

const tacoAbstract =
  "Geospatial communities have long relied on standardised formats for raster and vector data, enabling interoperability, stable tool development, and long-term data preservation. In contrast, Artificial Intelligence (AI)-ready datasets, particularly those derived from Earth Observation (EO), lack equivalent conventions. As a result, data producers often adopt ad hoc file structures, loosely defined formats, and inconsistent semantic encodings. This fragmentation hinders interoperability, complicates reuse, and undermines reproducibility. We argue that the lack of a standard format represents a structural bottleneck to scalable scientific progress, especially in the era of foundation models, where diverse datasets must be combined for effective training and performance evaluation in downstream tasks. To address this, we introduce TACO: a comprehensive specification that defines a formal data model, a cloud-optimized on-disk layout, and an API for creating and accessing AI-ready EO datasets.";

const eguAuthors = [
  "Oscar J. Pellicer-Valero",
  "Cesar Aybar",
  "Mikolaj Czerkawski",
  "Carmen Oliver",
  "Kevin Monsálvez",
  "Julio Contreras",
  "Gustau Camps-Valls",
];

const eguAbstract =
  "The field of Artificial Intelligence for Earth Observation (AI4EO) currently suffers from significant data friction, especially when moving Petabyte-scale archives from cloud object storage to High Performance Computing (HPC) nodes. We present TACO (Transparent Access to Cloud-Optimized datasets), a production-grade standard designed to replace file-centric legacy workflows with a high-throughput streaming paradigm. We showcase the practical implications of this architecture for the deployment of geospatial Foundation Models (FMs), by running pretrained FMs on downstream inference tasks (such as semantic segmentation or land-cover classification) directly on arbitrary samples of arbitrary cloud-hosted datasets, quickly, and without the need for local staging or any specific preprocessing.";

const isprsAuthors = ["David Montero", "César Aybar", "Miguel D. Mahecha", "Luis Gómez-Chova"];

const isprsAbstract =
  "Earth observation (EO) is essential to understanding the Earth system, enabling the transformation of planetary properties into measurable variables that can be analysed, compared, and modelled. In recent decades, EO capabilities have grown rapidly, accompanied by an even faster expansion in the number and variety of available EO instruments. However, despite this proliferation, users often lack a single, reliable source describing their existence and key characteristics. Here we present Awesome Earth Observation Instruments, an open, standardized, and community-oriented registry providing machine-readable metadata for EO instruments, hosted on GitHub and validated against a common schema.";

const authors = [
  "Julio Contreras¹*",
  "Carlos Giner¹*",
  "Cesar Aybar¹",
  "Gonzalo Mateo-García²",
  "Javier Gorroño³",
  "David Montero⁴,⁵",
  "Miguel D. Mahecha⁴,⁵",
  "Luis Guanter³",
  "Luis Gómez-Chova¹",
];

const affiliations = [
  "¹ Image and Signal Processing Group, Universitat de València, Spain",
  "² International Methane Emissions Observatory, United Nations Environment Programme, France",
  "³ Universitat Politècnica de València, Spain",
  "⁴ Remote Sensing Centre for Earth System Research (RSC4Earth), Leipzig University, Germany",
  "⁵ German Centre for Integrative Biodiversity Research (iDiv) Halle-Jena-Leipzig, Germany",
];

const bibtex = `@article{contreras2026methaneset,
  title   = {MethaneSET: Unified Multi-Sensor AI-Ready Datasets
             for Satellite-Based Methane Plume Detection},
  author  = {Contreras, Julio and Giner, Carlos and Aybar, Cesar
             and Mateo-Garcia, Gonzalo and Gorrono, Javier
             and Montero, David and Mahecha, Miguel D.
             and Guanter, Luis and Gomez-Chova, Luis},
  journal = {Scientific Data},
  year    = {2026}
}`;
---

<Base
  title="Papers | MethaneSET"
  description="The papers behind MethaneSET: the TACO specification, the EGU abstract, the instrument registry and the dataset manuscript."
>
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">Papers</p>
      <h1 class="paper-title">Papers</h1>
      <p class="lead">
        The papers behind the project, newest last: the TACO specification, its operational
        follow-up, the Earth observation instrument registry, and the MethaneSET manuscript.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <article class="paper">
        <div class="paper__head">
          <span class="paper__kind">Workshop paper · July 2025</span>
          <h2 class="paper__title">
            The Missing Piece: Standardising for AI-ready Earth Observation Datasets
          </h2>
        </div>

        <div class="prose paper__body">
          <p class="authors">{tacoAuthors.join(", ")}</p>
          <p class="venue">TerraBytes, ICML 2025 Workshop</p>

          <h3>Abstract</h3>
          <p>{tacoAbstract}</p>
        </div>

        <div class="paper__links">
          <a class="btn btn--ghost" href={url("papers/taco-icml-2025.pdf")} target="_blank" rel="noopener">
            Paper (PDF)
          </a>
          <a class="btn btn--ghost" href="https://icml.cc/virtual/2025/47927" target="_blank" rel="noopener">
            Abstract (TerraBytes)
          </a>
          <a class="btn btn--ghost" href="https://asterisk.coop/taco/spec" target="_blank" rel="noopener">
            Specification
          </a>
          <a class="btn btn--ghost" href="https://github.com/asterisk-labs/taco" target="_blank" rel="noopener">
            Source
          </a>
        </div>
      </article>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <article class="paper">
        <div class="paper__head">
          <span class="paper__kind">Conference abstract · May 2026</span>
          <h2 class="paper__title">TACO: Operationalizing AI-Ready EO datasets</h2>
        </div>

        <div class="prose paper__body">
          <p class="authors">{eguAuthors.join(", ")}</p>
          <p class="venue">EGU General Assembly 2026 · Vienna, Austria, 3-8 May 2026</p>

          <h3>Abstract</h3>
          <p>{eguAbstract}</p>
        </div>

        <div class="paper__links">
          <a class="btn btn--ghost" href="https://meetingorganizer.copernicus.org/EGU26/EGU26-8000.html" target="_blank" rel="noopener">
            Abstract (EGU)
          </a>
          <a class="btn btn--ghost" href="https://doi.org/10.5194/egusphere-egu26-8000" target="_blank" rel="noopener">
            DOI
          </a>
        </div>
      </article>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <article class="paper">
        <div class="paper__head">
          <span class="paper__kind">Journal paper · August 2026</span>
          <h2 class="paper__title">Towards an open registry of Earth observation instruments</h2>
        </div>

        <div class="prose paper__body">
          <p class="authors">{isprsAuthors.join(", ")}</p>
          <p class="venue">ISPRS Archives, L-4/W1-2026, 167-174</p>

          <h3>Abstract</h3>
          <p>{isprsAbstract}</p>
        </div>

        <div class="paper__links">
          <a class="btn btn--ghost" href="https://isprs-archives.copernicus.org/articles/L-4-W1-2026/167/2026/" target="_blank" rel="noopener">
            Paper (ISPRS)
          </a>
          <a class="btn btn--ghost" href="https://isprs-archives.copernicus.org/articles/L-4-W1-2026/167/2026/isprs-archives-L-4-W1-2026-167-2026.pdf" target="_blank" rel="noopener">
            PDF
          </a>
          <a class="btn btn--ghost" href="https://doi.org/10.5194/isprs-archives-L-4-W1-2026-167-2026" target="_blank" rel="noopener">
            DOI
          </a>
        </div>
      </article>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <article class="paper">
        <div class="paper__head">
          <span class="paper__kind">Manuscript · 2026</span>
          <h2 class="paper__title">
            MethaneSET: Unified Multi-Sensor AI-Ready Datasets for Satellite-Based Methane
            Plume Detection
          </h2>
        </div>

        <div class="prose paper__body">
          <p class="authors">{authors.join(", ")}</p>
          <p class="venue">Scientific Data · in preparation</p>
          <ul class="affils">
            {affiliations.map((a) => <li>{a}</li>)}
            <li>* Equal contribution.</li>
          </ul>

          <h3>Abstract</h3>
          <p>
            Detecting methane plumes from space at high spatial resolution relies on two
            broad classes of instruments that sample the shortwave infrared window:
            multispectral radiometers such as Sentinel-2 and Landsat 8/9, and imaging
            spectrometers such as EMIT, each with distinct data requirements.
            Multispectral radiometers possess only two broad shortwave infrared bands, so
            robust detection requires temporally paired acquisitions to isolate methane
            absorption. Imaging spectrometers sample the same window at much finer
            spectral resolution, giving high sensitivity to the methane signature and
            enabling detection from a single acquisition; their processing approaches
            differ, from matched-filter retrievals to deep learning, but all require
            calibrated radiance as input.
          </p>
          <p>
            No existing resource standardizes data across both instrument classes or
            provides the input diversity needed to train and benchmark detection models
            jointly. MethaneSET addresses this gap with datasets for Sentinel-2,
            Landsat 8/9, and EMIT under a unified metadata schema. The multispectral
            components include expert-verified plume masks and confirmed plume-free
            reference scenes. The hyperspectral EMIT component is, to our knowledge, the
            first to distribute calibrated radiance hypercubes alongside plume
            annotations, adding precomputed matched-filter products and two independently
            derived plume segmentation masks per scene. A synthetic plume bank of over one
            million enhancements from WRF-LES simulations enables both controlled data
            augmentation and physical sensitivity experiments across wind speeds, solar
            geometries, and source configurations. All datasets are distributed as Parquet
            catalogs with Cloud-Optimized GeoTIFFs.
          </p>

          <h3>Citation</h3>
          <pre class="code" set:html={bibtex}></pre>
        </div>

        <div class="paper__links">
          <a class="btn btn--ghost" href="https://huggingface.co/datasets/tacofoundation/methaneset" target="_blank" rel="noopener">
            Dataset on Hugging Face
          </a>
          <a class="btn btn--ghost" href="https://huggingface.co/datasets/tacofoundation/methaneset/blob/main/README.md" target="_blank" rel="noopener">
            Dataset card
          </a>
        </div>
      </article>
    </div>
  </section>
</Base>

<style>
