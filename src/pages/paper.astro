---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const url = (p = "") => `${base}${p.replace(/^\/+/, "")}`;

const tacoAuthors = [
  "Cesar Aybar¹",
  "Julio Contreras¹",
  "Chen Ma²",
  "Oscar J. Pellicer-Valero¹",
  "Gonzalo Mateo-García¹",
  "Luis Gómez-Chova¹",
  "Gustau Camps-Valls¹",
  "Nils Lehmann³",
  "Mikolaj Czerkawski⁴",
  "David Montero⁵",
  "Miguel D. Mahecha⁵",
  "Ingrid Aybar⁶",
];

const tacoAffiliations = [
  "¹ Image Processing Laboratory, University of Valencia, Spain",
  "² Research Center of Satellite Technology, Harbin Institute of Technology, China",
  "³ Technical University of Munich (TUM), Germany",
  "⁴ Asterisk Labs, London, UK",
  "⁵ Institute for Earth System Science and Remote Sensing, Leipzig University, Germany",
  "⁶ Facultad de Ingeniería, Universidad Privada del Norte, Lima, Peru",
];

const tacoAbstract =
  "Geospatial communities have long relied on standardised formats for raster and vector data, enabling interoperability, stable tool development, and long-term data preservation. In contrast, Artificial Intelligence (AI)-ready datasets, particularly those derived from Earth Observation (EO), lack equivalent conventions. As a result, data producers often adopt ad hoc file structures, loosely defined formats, and inconsistent semantic encodings. This fragmentation hinders interoperability, complicates reuse, and undermines reproducibility. We argue that the lack of a standard format represents a structural bottleneck to scalable scientific progress, especially in the era of foundation models, where diverse datasets must be combined for effective training and performance evaluation in downstream tasks. To address this, we introduce TACO: a comprehensive specification that defines a formal data model, a cloud-optimized on-disk layout, and an API for creating and accessing AI-ready EO datasets.";

const authors = [
  "Julio Contreras¹*",
  "Carlos Giner¹*",
  "Cesar Aybar¹",
  "Gonzalo Mateo-García²",
  "Javier Gorroño³",
  "David Montero⁴,⁵",
  "Miguel D. Mahecha⁴,⁵",
  "Luis Guanter³",
  "Luis Gómez-Chova¹",
];

const affiliations = [
  "¹ Image and Signal Processing Group, Universitat de València, Spain",
  "² International Methane Emissions Observatory, United Nations Environment Programme, France",
  "³ Universitat Politècnica de València, Spain",
  "⁴ Remote Sensing Centre for Earth System Research (RSC4Earth), Leipzig University, Germany",
  "⁵ German Centre for Integrative Biodiversity Research (iDiv) Halle-Jena-Leipzig, Germany",
];

const bibtex = `@article{contreras2026methaneset,
  title   = {MethaneSET: Unified Multi-Sensor AI-Ready Datasets
             for Satellite-Based Methane Plume Detection},
  author  = {Contreras, Julio and Giner, Carlos and Aybar, Cesar
             and Mateo-Garcia, Gonzalo and Gorrono, Javier
             and Montero, David and Mahecha, Miguel D.
             and Guanter, Luis and Gomez-Chova, Luis},
  journal = {Scientific Data},
  year    = {2026}
}`;
---

<Base
  title="Papers | MethaneSET"
  description="The TACO specification paper and the MethaneSET manuscript."
>
  <section class="section">
    <div class="container prose">
      <h1>Papers</h1>
      <p class="lead">
        Two papers: the TACO specification this project is built on, and the MethaneSET
        manuscript describing the datasets.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <article class="paper">
        <div class="paper__head">
          <p class="paper__kind">Specification</p>
          <h2 class="paper__title">
            The Missing Piece: Standardising for AI-ready Earth Observation Datasets
          </h2>
          <p class="venue">TerraBytes, ICML 2025 Workshop</p>
        </div>

        <div class="prose paper__body">
          <p class="authors">{tacoAuthors.join(", ")}</p>
          <ul class="affils">
            {tacoAffiliations.map((a) => <li>{a}</li>)}
          </ul>

          <h3>Abstract</h3>
          <p>{tacoAbstract}</p>
        </div>

        <div class="paper__links">
          <a class="btn btn--ghost" href={url("papers/taco-icml-2025.pdf")} target="_blank" rel="noopener">
            Paper (PDF)
          </a>
          <a class="btn btn--ghost" href="https://asterisk.coop/taco/spec" target="_blank" rel="noopener">
            Specification
          </a>
          <a class="btn btn--ghost" href="https://github.com/asterisk-labs/taco" target="_blank" rel="noopener">
            Source
          </a>
        </div>
      </article>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <article class="paper">
        <div class="paper__head">
          <p class="paper__kind">Manuscript</p>
          <h2 class="paper__title">
            MethaneSET: Unified Multi-Sensor AI-Ready Datasets for Satellite-Based Methane
            Plume Detection
          </h2>
          <p class="venue">Scientific Data, under review</p>
        </div>

        <div class="prose paper__body">
          <p class="authors">{authors.join(", ")}</p>
          <ul class="affils">
            {affiliations.map((a) => <li>{a}</li>)}
            <li>* Equal contribution.</li>
          </ul>

          <h3>Abstract</h3>
          <p>
            Detecting methane plumes from space at high spatial resolution relies on two
            broad classes of instruments that sample the shortwave infrared window:
            multispectral radiometers such as Sentinel-2 and Landsat 8/9, and imaging
            spectrometers such as EMIT, each with distinct data requirements.
            Multispectral radiometers possess only two broad shortwave infrared bands, so
            robust detection requires temporally paired acquisitions to isolate methane
            absorption. Imaging spectrometers sample the same window at much finer
            spectral resolution, giving high sensitivity to the methane signature and
            enabling detection from a single acquisition; their processing approaches
            differ, from matched-filter retrievals to deep learning, but all require
            calibrated radiance as input.
          </p>
          <p>
            No existing resource standardizes data across both instrument classes or
            provides the input diversity needed to train and benchmark detection models
            jointly. MethaneSET addresses this gap with datasets for Sentinel-2,
            Landsat 8/9, and EMIT under a unified metadata schema. The multispectral
            components include expert-verified plume masks and confirmed plume-free
            reference scenes. The hyperspectral EMIT component is, to our knowledge, the
            first to distribute calibrated radiance hypercubes alongside plume
            annotations, adding precomputed matched-filter products and two independently
            derived plume segmentation masks per scene. A synthetic plume bank of over one
            million enhancements from WRF-LES simulations enables both controlled data
            augmentation and physical sensitivity experiments across wind speeds, solar
            geometries, and source configurations. All datasets are distributed as Parquet
            catalogs with Cloud-Optimized GeoTIFFs.
          </p>

          <h3>Citation</h3>
          <pre class="code" set:html={bibtex}></pre>
        </div>

        <div class="paper__links">
          <a class="btn btn--ghost" href="https://huggingface.co/datasets/tacofoundation/methaneset" target="_blank" rel="noopener">
            Dataset on Hugging Face
          </a>
          <a class="btn btn--ghost" href="https://huggingface.co/datasets/tacofoundation/methaneset/blob/main/README.md" target="_blank" rel="noopener">
            Dataset card
          </a>
        </div>
      </article>
    </div>
  </section>
</Base>

<style>
  /* A publications page, not a card wall: each entry is a rule, a kind, a
     title, the people, then the text. */
  .paper {
    border-top: 1px solid var(--line-strong);
    padding-top: 26px;
    max-width: 78ch;
  }
  .paper__kind {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate);
    margin: 0 0 14px;
  }
  .paper__title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.18;
    margin: 0 0 12px;
  }
  .venue {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--slate);
    margin: 0;
  }
  .paper__body {
    max-width: none;
    margin-top: 26px;
  }
  .authors {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text);
    margin: 0 0 12px;
  }
  .affils {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--slate);
  }
  .affils li {
    margin: 0;
  }
  .paper__body h3 {
    margin: 2.2em 0 0.7em;
    padding-bottom: 0.6em;
    border-bottom: 1px solid var(--line);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate);
  }
  .paper__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }
</style>
