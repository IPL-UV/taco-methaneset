---
import Base from "../layouts/Base.astro";
import Globe from "../components/Globe.astro";
import DatasetCard from "../components/DatasetCard.astro";
import { datasets, totals, fmtSize } from "../data/datasets";

const fmt = (n: number) => n.toLocaleString("en-US");
---

<Base
  title="Data | MethaneSET"
  description="Explore the MethaneSET plume observations and download the seven TACO datasets."
>
  <section class="section section--tight">
    <div class="container">
      <h1>Every verified plume, on the map</h1>
      <p class="lead">
        Each point is a real observation where a monitoring system verified a plume:
        EMIT granules confirmed by both IMEO and Carbon Mapper, and Sentinel-2 and
        Landsat 8/9 scenes annotated by IMEO MARS. Filter by sensor or country, and
        select a point for its details. The plume bank has no geographic reference, so it
        is not on the map.
      </p>
    </div>
  </section>

  <section class="map" aria-label="Map of verified methane plumes">
    <Globe scrollZoom={true} controls={true} />
  </section>

  <section class="section">
    <div class="container">
      <h2>Seven datasets</h2>
      <p class="lead">
        Load any of them with one line. Metadata is queryable as Parquet before you
        download a pixel.
      </p>
      <div class="grid grid--2" style="margin-top:44px;">
        {datasets.map((d) => <DatasetCard dataset={d} />)}
      </div>
      <span class="src">
        {totals.datasets} datasets, {fmt(totals.samples)} samples, ~{fmtSize(totals.sizeGB)}. Counts from the published
        <a href="https://huggingface.co/datasets/tacofoundation/methaneset" target="_blank" rel="noopener">
          MethaneSET card
        </a>, verified against the Parquet indexes (721 EMIT granules across 60 countries,
        2022-08 to 2025-11).
      </span>
    </div>
  </section>
</Base>

<style>
  .map {
    position: relative;
    height: 74vh;
    min-height: 540px;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  @media (max-width: 720px) {
    .map {
      height: 68svh;
      min-height: 440px;
    }
  }
</style>

<script>
  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-copy]");
    if (!button) return;
    const value = button.dataset.copy ?? "";
    navigator.clipboard?.writeText(value).then(() => {
      const previous = button.textContent;
      button.textContent = "copied";
      setTimeout(() => (button.textContent = previous), 1200);
    });
  });
</script>
