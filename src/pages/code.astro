---
import Base from "../layouts/Base.astro";

const examples = [
  {
    title: "Sentinel-2: catalog to a pixel baseline",
    body: "Open the two subsets, reproduce the MBMP enhancement and train a minimal pixel classifier.",
    tag: "Multispectral",
    href: "https://colab.research.google.com/github/IPL-UV/taco-methaneset/blob/main/methaneset-codes/notebooks/01_s2.ipynb",
  },
  {
    title: "Landsat 8/9: the same tour",
    body: "The Landsat counterpart: schema, EDA, B6/B7 enhancement and the baseline.",
    tag: "Multispectral",
    href: "https://colab.research.google.com/github/IPL-UV/taco-methaneset/blob/main/methaneset-codes/notebooks/02_l89.ipynb",
  },
  {
    title: "EMIT: radiance, matched filters, masks",
    body: "Stream the 285-band cube, decode the uint64 bitmask plumes and measure IMEO vs Carbon Mapper IoU.",
    tag: "Hyperspectral",
    href: "https://colab.research.google.com/github/IPL-UV/taco-methaneset/blob/main/methaneset-codes/notebooks/03_emit.ipynb",
  },
  {
    title: "Plume bank and synthetic injection",
    body: "Query the bank by solar geometry and wind, scale a map to any rate and inspect the LES cubes.",
    tag: "Bank",
    href: "https://colab.research.google.com/github/IPL-UV/taco-methaneset/blob/main/methaneset-codes/notebooks/04_bank.ipynb",
  },
  {
    title: "Query the catalog",
    body: "Filter samples by country, date or flux with SQL over the Parquet index, before downloading imagery.",
    tag: "Metadata",
    href: "https://huggingface.co/datasets/tacofoundation/methaneset",
  },
];
---

<Base
  title="Code | MethaneSET"
  description="Load and query MethaneSET from Python, R, Julia or the browser, and run the examples."
>
  <section class="section">
    <div class="container prose">
      <h1>Load and query</h1>
      <p class="lead">
        Metadata is a Parquet index, imagery is cloud-optimized. Read the index, filter
        what you need, then fetch only those pixels by byte range.
      </p>

      <pre class="code"><span class="tok-com"># pip install tacoreader</span>
<span class="tok-key">import</span> tacoreader

ds = tacoreader.load(
  <span class="tok-str">"https://huggingface.co/datasets/tacofoundation/methaneset/resolve/main/methaneset-emit/"</span>
)
df = ds.data.to_pandas()
df[df[<span class="tok-str">"site:country"</span>] == <span class="tok-str">"Turkmenistan"</span>]</pre>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <h2>Explore and reproduce</h2>
      <p class="lead">
        Each example is a small recipe: load one dataset, do one thing, and keep the
        result.
      </p>
      <div class="grid grid--2" style="margin-top:40px;">
        {
          examples.map((e) => (
            <a class="card ex" href={e.href} target="_blank" rel="noopener">
              <div class="card__tag">{e.tag}</div>
              <h3>{e.title}</h3>
              <p>{e.body}</p>
              <span class="ex__go">Open →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container prose">
      <h2>Install the clients</h2>
      <table>
        <thead>
          <tr><th scope="col">Language</th><th scope="col">Install</th></tr>
        </thead>
        <tbody>
          <tr><td>Python</td><td><code>pip install tacoreader</code></td></tr>
          <tr><td>R</td><td><code>install.packages("taco", repos = "https://asterisk-labs.r-universe.dev")</code></td></tr>
          <tr><td>Julia</td><td><code>Pkg.add("Taco")</code></td></tr>
          <tr><td>JavaScript</td><td><code>npm install @asterisk-labs/taco</code></td></tr>
        </tbody>
      </table>
      <p>
        The Python client is the reference implementation and the only one that writes.
        See <a href="https://pypi.org/project/tacoreader" target="_blank" rel="noopener">tacoreader</a> on PyPI.
      </p>

      <span class="src">
        Notebooks and clients from the
        <a href="https://huggingface.co/datasets/tacofoundation/methaneset" target="_blank" rel="noopener">
          MethaneSET dataset card
        </a>.
      </span>
    </div>
  </section>
</Base>

<style>
  /* flex column so "Open" lines up along the bottom of every card in a row */
  .ex {
    display: flex;
    flex-direction: column;
    color: inherit;
  }
  .ex:hover {
    color: inherit;
  }
  .ex p {
    flex: 1;
  }
  .ex__go {
    display: inline-block;
    margin-top: 20px;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--accent-text);
  }
</style>
