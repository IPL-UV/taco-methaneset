---
import "../styles/theme.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { url } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "MethaneSET · AI-ready methane datasets",
  description = "Unified multi-sensor TACO datasets for satellite-based methane plume detection: Sentinel-2, Landsat 8/9 and EMIT, with expert-verified plume masks and a synthetic plume bank.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={url("favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          document.documentElement.setAttribute(
            "data-theme",
            localStorage.getItem("theme") || "dark",
          );
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
    <script is:inline>
      /* Arm the scroll-reveal styles before first paint, so nothing flashes.
         Without JS (or with reduced motion) the class never lands and every
         element stays visible. */
      (function () {
        var root = document.documentElement;
        var reduced =
          window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if ("IntersectionObserver" in window && !reduced) root.classList.add("js-reveal");
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        var root = document.documentElement;

        /* --- Reading progress + condensed nav ------------------------- */
        var ticking = false;
        function paintScroll() {
          ticking = false;
          var y = window.scrollY || window.pageYOffset || 0;
          var travel = root.scrollHeight - window.innerHeight;
          root.style.setProperty("--scroll", travel > 0 ? Math.min(1, y / travel).toFixed(4) : "0");
          if (y > 8) root.setAttribute("data-scrolled", "");
          else root.removeAttribute("data-scrolled");
        }
        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(paintScroll);
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        paintScroll();

        /* --- Scroll reveal -------------------------------------------- */
        if (!root.classList.contains("js-reveal")) return;

        /* Keep in sync with the .js-reveal block in theme.css */
        var SELECTOR =
          ".section .container > *:not(.grid):not(.stats):not(.steps)," +
          ".grid > *,.stats > *,.steps > *";

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-in");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
        );

        /* Stagger only inside grids, whose items enter together. Items stacked
           down a column scroll in one by one, so a delay there just feels slow. */
        var groups = new Map();
        document.querySelectorAll(SELECTOR).forEach(function (el) {
          var parent = el.parentElement;
          if (parent && parent.matches(".grid, .stats, .steps")) {
            var i = groups.get(parent) || 0;
            groups.set(parent, i + 1);
            if (i > 0) el.style.setProperty("--rd", Math.min(i, 5));
          }
          observer.observe(el);
        });
      })();
    </script>
  </body>
</html>
